<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:TestNote"
             x:Class="TestNote.App"
             xmlns:converters="clr-namespace:TestNote.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:RoleToNameConverter x:Key="RoleToNameConverter" />
            <converters:TestStatusColorConverter x:Key="TestStatusColorConverter" />
            <converters:BoolToStrikeThroughConverter x:Key="BoolToStrikeThroughConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
