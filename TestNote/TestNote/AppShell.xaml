<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TestNote.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:TestNote"
    Title="TestNote">

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate local:Login}"
        Route="Login" />

    <ShellContent
        Title="Empresas"
        ContentTemplate="{DataTemplate local:Companies}"
        Route="Empresas" />

</Shell>
