<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TestNote.ViewModels"
             x:Class="TestNote.Views.TestCreatePage"
             x:DataType="vm:TestCreateViewModel"
             Title="Criar novo teste">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <VerticalStackLayout Spacing="8">
                <Label Text="Título do Teste:"/>
                <Entry Placeholder="Insira o título do teste" Text="{Binding Title}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="Descrição / Instruções:"/>
                <Editor Placeholder="Insira a descrição / instruções" Text="{Binding Description}" HeightRequest="80" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="Itens de Verificação (Checklist):" FontAttributes="Bold" />
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="16">
                    <Entry Grid.Column="0" Placeholder="Adicionar item" Text="{Binding NewItemText}" ReturnCommand="{Binding AddItemCommand}"/>
                    <Button Grid.Column="1" Text="+" Command="{Binding AddItemCommand}" WidthRequest="50"/>
                </Grid>
                <StackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="5">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="5" ColumnDefinitions="*, Auto">
                                <Label Text="{Binding .}" VerticalOptions="Center"/>
                                <Button Grid.Column="1" Text="X" 
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TestCreateViewModel}}, Path=RemoveItemCommand}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="#FF3B30" 
                                    TextColor="White"
                                    HeightRequest="35" WidthRequest="35" Padding="0"
                                    CornerRadius="17"/>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </StackLayout>
            </VerticalStackLayout>

            <Button Text="Salvar Teste" Command="{Binding SaveTestCommand}" BackgroundColor="#34C759" TextColor="White"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>