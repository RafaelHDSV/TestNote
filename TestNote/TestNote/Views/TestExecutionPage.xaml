<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TestNote.ViewModels"
             x:Class="TestNote.Views.TestExecutionPage"
             x:DataType="vm:TestExecutionViewModel"
             Title="Executar Teste">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <VerticalStackLayout Spacing="5">
                <Label Text="{Binding Test.Title}" FontSize="24" FontAttributes="Bold" TextColor="#333"/>
                <Label Text="{Binding Test.Description}" TextColor="Gray" FontSize="14" LineBreakMode="WordWrap"/>

                <Label Text="{Binding CompletedCount, StringFormat='Progresso: {0} / {1} itens'}" 
                       TextColor="{Binding Test.ProgressColor}" 
                       FontAttributes="Bold" 
                       FontSize="14"
                       HorizontalOptions="Start"/>

                <ProgressBar Progress="{Binding CompletionProgress}" 
                             ProgressColor="{Binding Test.ProgressColor}"
                             HeightRequest="8"/>
            </VerticalStackLayout>

            <BoxView HeightRequest="1" Color="LightGray" />

            <Label Text="Checklist de Execução:" FontAttributes="Bold" FontSize="16"/>

            <StackLayout BindableLayout.ItemsSource="{Binding CheckItems}" Spacing="10">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:CheckItem">
                        <HorizontalStackLayout Spacing="10" Padding="5">
                            <CheckBox IsChecked="{Binding IsChecked}" 
                                      Color="#34C759" />
                            <Label Text="{Binding Description}" 
                                   VerticalOptions="Center" 
                                   FontSize="15"
                                   LineBreakMode="WordWrap"
                                   TextDecorations="{Binding IsChecked, Converter={StaticResource BoolToStrikeThroughConverter}}"/>
                        </HorizontalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </StackLayout>

            <BoxView HeightRequest="1" Color="LightGray" />

            <VerticalStackLayout Spacing="8">
                <Label Text="Observações do Funcionário (Opcional):" FontAttributes="Bold" FontSize="16"/>
                <Editor Placeholder="Adicione comentários, problemas ou detalhes da execução." 
                        Text="{Binding ExecutionNotes}" 
                        HeightRequest="100"/>
            </VerticalStackLayout>


            <Button Text="Salvar Progresso / Finalizar Teste" 
                    Command="{Binding CompleteTestCommand}" 
                    BackgroundColor="{Binding Test.ProgressColor}" 
                    TextColor="White"
                    Margin="0,10,0,0"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>