<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:TestNote.ViewModels"
    x:DataType="vm:CompanyDetailViewModel"
    x:Class="TestNote.Views.CompanyDetails"
    Title="Detalhes da Empresa">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Border StrokeThickness="0.2" StrokeShape="RoundRectangle 12" BackgroundColor="White" Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding Company.Name}" FontSize="24" FontAttributes="Bold" TextColor="#333"/>
                    <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto">
                        <Label Grid.Row="0" Grid.Column="0" Text="Dono:" FontAttributes="Bold" TextColor="#555"/>
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding Company.Owner}" TextColor="#555"/>

                        <Label Grid.Row="1" Grid.Column="0" Text="Setor:" FontAttributes="Bold" TextColor="#555"/>
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding Company.Sector}" TextColor="#555"/>

                        <Label Grid.Row="2" Grid.Column="0" Text="Funcionários:" FontAttributes="Bold" TextColor="#555"/>
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding Company.NumberOfEmployees}" TextColor="#555"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="12">
                <Button Text="Editar Empresa"
                        BackgroundColor="#007AFF"
                        TextColor="White"
                        CornerRadius="8"
                        HeightRequest="50"
                        Command="{Binding EditCompanyCommand}" />

                <Button Text="Ver Testes da Empresa"
                        BackgroundColor="#34C759"
                        TextColor="White"
                        CornerRadius="8"
                        HeightRequest="50"
                        Command="{Binding OpenTestsCommand}" />

                <Button Text="Ver Funcionários da Empresa"
                        BackgroundColor="#FF9500"
                        TextColor="White"
                        CornerRadius="8"
                        HeightRequest="50"
                        Command="{Binding OpenEmployeesCommand}" />

                <Button Text="Voltar"
                        BackgroundColor="#FF3B30"
                        TextColor="White"
                        CornerRadius="8"
                        HeightRequest="50"
                        Command="{Binding GoBackCommand}" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
