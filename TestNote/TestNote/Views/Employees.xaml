<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TestNote.ViewModels" 
             xmlns:models="clr-namespace:TestNote.Models"
             x:DataType="vm:EmployeesViewModel"
             x:Class="TestNote.Views.Employees"
             Title="{Binding Company.Name, StringFormat='Funcionários ({0})'}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Adicionar Funcionário" 
                     Command="{Binding GoToCreateEmployeeCommand}" />
    </ContentPage.ToolbarItems>
    
    <Grid RowDefinitions="Auto, *">

        <ActivityIndicator Grid.Row="0" 
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           Color="#1976D2"
                           HorizontalOptions="Center" 
                           VerticalOptions="Start"
                           Margin="10"/>

        <VerticalStackLayout Grid.Row="1" Padding="20">
            <CollectionView
                Grid.Row="1"
                ItemsSource="{Binding Employees}"
                SelectionMode="Single"
                SelectedItem="{Binding SelectedEmployee}">

                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                        <Label Text="📭" FontSize="40" HorizontalOptions="Center"/>
                        <Label Text="Nenhum funcionário encontrado."
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="Gray"
                               HorizontalOptions="Center"/>
                        <Label Text="Clique no botão 'Adicionar Funcionário' acima para adicionar."
                               FontSize="12"
                               TextColor="Gray"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Employee">
                        <Border Margin="0,5" Padding="15"
                            StrokeShape="RoundRectangle 8"
                            BackgroundColor="White"
                            HorizontalOptions="Fill">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer 
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EmployeesViewModel}}, Path=SelectEmployeeCommand}"
                                CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding DisplayName}"
                                       TextColor="#000"
                                       FontSize="18"
                                    />
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="Email:"
                                        FontSize="13"
                                        TextColor="#444"
                                        FontAttributes="Bold"
                                        LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Email}"
                                        FontSize="13"
                                        TextColor="#444"
                                        LineBreakMode="TailTruncation" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="Cargo:"
                                        FontSize="13"
                                        TextColor="#444"
                                        FontAttributes="Bold"
                                        LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding JobTitle}"
                                        FontSize="13"
                                        TextColor="#444"
                                        LineBreakMode="TailTruncation" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="Tipo:"
                                        FontSize="13"
                                        TextColor="#444"
                                        FontAttributes="Bold"
                                        LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding RoleName}"
                                        FontSize="13"
                                        TextColor="#444"
                                        LineBreakMode="TailTruncation" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </Grid>
</ContentPage>