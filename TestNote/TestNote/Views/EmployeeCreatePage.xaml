<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TestNote.ViewModels"
             x:Class="TestNote.Views.EmployeeCreatePage"
             x:DataType="vm:EmployeeCreateViewModel"
             Title="Novo Funcionário">

    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Cadastrar Novo Funcionário" FontSize="18" FontAttributes="Bold" TextColor="#1976D2"/>

        <Entry Placeholder="Nome Completo" Text="{Binding Name}" />
        <Entry Placeholder="Cargo / Função" Text="{Binding JobTitle}" />
        <Entry Placeholder="Email de Login" Keyboard="Email" Text="{Binding Email}" />
        <Entry Placeholder="Senha" IsPassword="True" Text="{Binding Password}" />

        <Button Text="Salvar Funcionário" 
                Command="{Binding SaveEmployeeCommand}" 
                BackgroundColor="#1976D2" 
                TextColor="White"
                Margin="0,20,0,0"/>
    </VerticalStackLayout>
</ContentPage>