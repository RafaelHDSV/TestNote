<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TestNote.ViewModels"
             x:Class="TestNote.Views.EmployeeCreatePage"
             x:DataType="vm:EmployeeCreateViewModel"
             Title="Novo Funcionário">

    <VerticalStackLayout Padding="20" Spacing="15">
        <VerticalStackLayout Spacing="8">
            <Label Text="Nome Completo:"/>
            <Entry Placeholder="Insira o nome completo" Text="{Binding Name}" />
        </VerticalStackLayout>

        <VerticalStackLayout Spacing="8">
            <Label Text="Cargo / Função: "/>
            <Entry Placeholder="Insira o cargo / função" Text="{Binding JobTitle}" />
        </VerticalStackLayout>

        <VerticalStackLayout Spacing="8">
            <Label Text="Email:"/>
            <Entry Placeholder="Insira o email" Keyboard="Email" Text="{Binding Email}" />
        </VerticalStackLayout>

        <VerticalStackLayout Spacing="8">
            <Label Text="Senha:"/>
            <Entry Placeholder="Insira a senha" IsPassword="True" Text="{Binding Password}" />
        </VerticalStackLayout>

        <Button Text="Salvar Funcionário" 
                Command="{Binding SaveEmployeeCommand}" 
                BackgroundColor="#1976D2" 
                TextColor="White"
                Margin="0,20,0,0"/>
    </VerticalStackLayout>
</ContentPage>