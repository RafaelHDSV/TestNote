<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TestNote.ViewModels"
             x:Class="TestNote.Views.EmployeeEditPage"
             x:DataType="vm:EmployeeEditViewModel"
             Title="Editar Funcionário">

    <VerticalStackLayout Padding="20" Spacing="15">
        <VerticalStackLayout Spacing="8">
            <Label Text="Nome Completo:" />
            <Entry Placeholder="Insira o nome completo" Text="{Binding Name}" />
        </VerticalStackLayout>

        <VerticalStackLayout Spacing="8">
            <Label Text="Cargo / Função:" />
            <Entry Placeholder="Insira o cargo / função" Text="{Binding JobTitle}" />
        </VerticalStackLayout>

        <VerticalStackLayout Spacing="8">
            <Label Text="Email:" />
            <Entry Placeholder="Insira o email" Keyboard="Email" Text="{Binding Email}" />
        </VerticalStackLayout>

        <VerticalStackLayout Spacing="8">
            <Label Text="Nova senha:" />
            <Entry Placeholder="Insira uma nova senha (Opcional)" IsPassword="True" Text="{Binding Password}" />
            <Label Text="Deixe em branco para manter a senha atual." FontSize="10" TextColor="Gray" Margin="0,-5,0,0"/>
        </VerticalStackLayout>

        <Button Text="Salvar Alterações" 
                Command="{Binding UpdateEmployeeCommand}" 
                BackgroundColor="#007AFF" 
                TextColor="White"
                Margin="0,20,0,0"/>
    </VerticalStackLayout>
</ContentPage>