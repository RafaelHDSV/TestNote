<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TestNote.Companies"
             Title="Empresas">
    <Grid Padding="20" RowDefinitions="Auto,*" RowSpacing="10">

        <Label Text="Empresas"
               FontSize="28"
               FontAttributes="Bold"
               TextColor="#333" />

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding CompaniesList}"
                        SelectionMode="Single"
                        x:Name="CompaniesCollection">

            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                 Span="2" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="10"
                           Padding="15"
                           HasShadow="True"
                           CornerRadius="12"
                           BackgroundColor="White">

                        <VerticalStackLayout Spacing="6">

                            <Label Text="{Binding Name}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#222" />

                            <Label Text="{Binding Owner}"
                                   FontSize="13"
                                   TextColor="#666"
                                   LineBreakMode="TailTruncation" />

                            <Label Text="{Binding Sector}"
                                   FontSize="13"
                                   TextColor="#666"
                                   LineBreakMode="TailTruncation" />

                            <Label Text="{Binding NumberOfEmployees}"
                                   FontSize="13"
                                   TextColor="#666"
                                   LineBreakMode="TailTruncation" />
                            
                            <HorizontalStackLayout>
                                <Label Text="ID:"
                                       FontSize="12"
                                       TextColor="#999" />

                                <Label Text="{Binding Id}"
                                       FontSize="12"
                                       TextColor="#555" />
                            </HorizontalStackLayout>

                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>